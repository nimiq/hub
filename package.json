{
    "name": "@nimiq/hub",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "serve": "yarn i18n:extract && vue-cli-service serve",
        "build": "yarn i18n:extract && vue-cli-service build",
        "build:ci": "yarn i18n:extract && build=testnet vue-cli-service build",
        "lint": "tslint --project tsconfig.json",
        "test:unit": "vue-cli-service test:unit",
        "test": "yarn test:unit",
        "pr": "yarn lint && yarn build:ci && yarn test && cd client && yarn lint && yarn build",
        "postinstall": "patch-package && cd client && yarn",
        "update-browserslist": "yarn update-browserslist-db",
        "release": "./deploy.sh",
        "i18n:extract": "node ./node_modules/webpack-i18n-tools/index.js ./src/i18n/en.po",
        "i18n:pull": "tx pull --all --force --minimum-perc 90",
        "i18n:push": "tx push --source",
        "i18n:sync": "yarn i18n:extract && yarn i18n:push ; yarn i18n:pull"
    },
    "dependencies": {
        "@nimiq/browser-warning": "^1.1.1",
        "@nimiq/core": "^2.23.0",
        "@nimiq/electrum-client": "https://github.com/nimiq/electrum-client#build",
        "@nimiq/fastspot-api": "^1.10.3",
        "@nimiq/iqons": "^1.5.2",
        "@nimiq/keyguard-client": "^1.12.0",
        "@nimiq/ledger-api": "^4.0.1",
        "@nimiq/oasis-api": "^1.1.1",
        "@nimiq/rpc": "^0.4.1",
        "@nimiq/style": "^0.8.2",
        "@nimiq/utils": "^0.11.7",
        "@nimiq/vue-components": "https://github.com/nimiq/vue-components#build/hub",
        "@sentry/vue": "^8.55.0",
        "big-integer": "^1.6.52",
        "ethers": "^5.8.0",
        "vue": "^2.7.16",
        "vue-i18n": "^8.28.2",
        "vue-property-decorator": "^8.5.1",
        "vue-router": "^3.6.5",
        "vuex": "^3.6.2",
        "vuex-class": "^0.3.2"
    },
    "devDependencies": {
        "@vue/cli-plugin-babel": "~5.0.9",
        "@vue/cli-plugin-typescript": "~5.0.9",
        "@vue/cli-plugin-unit-jest": "~5.0.9",
        "@vue/cli-plugin-vuex": "~5.0.9",
        "@vue/cli-service": "~5.0.9",
        "@vue/test-utils": "^1.0.0-beta.29",
        "@vue/vue2-jest": "^27.0.0-alpha.3",
        "babel-jest": "27",
        "bitcoinjs-lib": "5.2.0",
        "buffer": "5.6.0",
        "core-js": "^3.51.0",
        "dtslint": "^4.2.1",
        "fake-indexeddb": "^2.0.5",
        "jest": "^27.1.0",
        "patch-package": "^6.5.1",
        "postinstall-postinstall": "^2.1.0",
        "readable-stream": "^4.8.0",
        "ts-jest": "^27.0.0",
        "tslint": "^6.1.3",
        "typescript": "~4.9.5",
        "vue-template-compiler": "^2.7.16",
        "webpack-i18n-tools": "https://github.com/nimiq/webpack-i18n-tools#master"
    }
}
